 },
 "editable": false,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Active users (latest 60s window, summed over pages)",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT COALESCE(sum(active_users),0) AS users FROM windowed_user_metrics WHERE window_end = (SELECT max(window_end) FROM windowed_user_metrics WHERE window_end <= now() AT TIME ZONE 'utc')"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value"
   }
  },
  {
