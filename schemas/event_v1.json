{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kscep.event.v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "user_id",
    "session_id",
    "event_type",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "event_type": {
      "type": "string",
      "enum": [
        "page_view",
        "cart_add",
        "purchase",
        "page_exit"
      ]
    },
    "page_url": {
      "type": "string",
      "maxLength": 512
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "product_category": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "price_inr": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
